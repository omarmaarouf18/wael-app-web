# El Metr Academy website — every variable the site reads.
# Copy to .env.local for `npm run dev`; set the same names in Vercel
# (Project → Settings → Environment Variables). No secrets belong here:
# every NEXT_PUBLIC_ value is compiled into the browser bundle.

# Base URL of the shared backend (api-gateway). Origin only, https.
# Also the only extra origin the Content-Security-Policy allows in
# connect-src. http is accepted only for localhost / 127.0.0.1 (local dev).
# Default when unset: https://api.elmetracademy.app
NEXT_PUBLIC_API_BASE_URL=https://api.elmetracademy.app

# Server-side API origin for the catalog pages (ADR-0014 W2b): Next.js reads
# GET /api/v1/academy/public/catalog on the server at build time and every
# 300 s, never in the browser. NOT a NEXT_PUBLIC_ variable: it is never in
# the browser bundle. Same rules as above (origin only, https; http only for
# localhost). Required on Vercel (the build fails without it). Unset off
# Vercel (CI, local builds): the catalog pages build as "unavailable" and no
# request is made.
API_BASE_URL=https://api.elmetracademy.app
